# Clave de API de Gemini; se pega en .env y nunca se escribe en el código.
GOOGLE_API_KEY=tu_clave_gemini_aqui

# Clave de API de ElevenLabs para síntesis de voz (audio) de las respuestas.
VITE_ELEVENLABS_API_KEY=tu_clave_elevenlabs_aqui
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Modelo de Gemini que usan los agentes.
MODELO=gemini-2.5-flash

# Token de acceso para proteger el servicio FastAPI y el canal web.
TOKEN_ACCESO=uai-2026

# Host y puerto donde escucha el servidor web / API protegida.
HOST_WEB=127.0.0.1
PUERTO_WEB=8000

# Dirección donde va a escuchar el coordinador A2A.
URL_COORDINADOR=http://127.0.0.1:8007

# Dirección pública del túnel (la da cloudflared). Si existe, la ficha usa esta en vez de la local.
URL_PUBLICA=

# Direcciones de los agentes locales A2A.
URL_PASTELERO=http://127.0.0.1:8002
URL_MUSICA=http://127.0.0.1:8003
URL_INNOVACION=http://127.0.0.1:8004

# Lista de direcciones de agentes de otros computadores, separadas por comas.
URLS_AGENTES=